% Paprastas skriptas

x = 1:32;
y = x.^2;

plot(x, y, 'o-r', x, y/3, 'xb')
title('Dvi funkcijos')
xlabel('X-ašis')
ylabel('F_1 [-o-]   |   F_2 [-x-]')

% Papildomos uzduotys

% 1.

N = 8;

% 2. Vektorius
v = N+1:0.5:N+4;

% 3. 3x3 matrica A
A = N:N+8;
A = reshape(A, 3, 3)';

% 4. a)
a = A(3,2);

% b)
b = A(2:3,1:2);

% c)
c = A([1 3],[1 3]);


v2 = v(1:3)';

% Vektoriaus prijungimas prie matricos A
A2 = [A v2];

disp('Vektorius v:');
disp(v);

disp('Matrica A:');
disp(A);

disp('a):');
disp(a);

disp('b):');
disp(b);

disp('c):');
disp(c);

disp('Matrica A su prijungtu vektoriumi:');
disp(A2);